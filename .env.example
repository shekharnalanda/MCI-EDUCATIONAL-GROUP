APP_NAME="MCI Educational Group"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mciedu.in
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="mcieducationalgroup@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional WhatsApp Business Platform (Meta Cloud API)
# Keep disabled until a Meta business portfolio, WhatsApp Business Account,
# registered business phone number and approved outbound template are ready.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional SMS channel. India commercial/service SMS must be DLT-compliant.
# The generic_json driver expects a provider endpoint that accepts the standard
# JSON payload documented by app/Services/OutboundMessagingService.php.
SMS_ENABLED=false
SMS_DRIVER=generic_json
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID=

ADMIN_NAME="MCI Administrator"
ADMIN_EMAIL="mcieducationalgroup@gmail.com"
ADMIN_PASSWORD=
